# No Riot API key is needed: this service only reads data your collector already saved.
DEMO_MODE=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leaguematch
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
# Use DB_SSL=require (or verify-full) for a remote Postgres database.
# Use the direct connection URL rather than a pooler when using asyncpg.
DB_SSL=disable
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional alternative to the DB_* settings; never expose this in VITE_* variables.
# DATABASE_URL=postgresql://user:password@host:5432/database
